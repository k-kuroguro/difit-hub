{
   "imports": {
      "@/": "./",
      "@david/dax": "jsr:@david/dax@0.50.2",
      "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@2.6.2",
      "@std/assert": "jsr:@std/assert@1.0.13",
      "@std/async": "jsr:@std/async@1.5.1"
   },
   "lint": {
      "rules": {
         "tags": [
            "recommended"
         ]
      }
   },
   "fmt": {
      "indentWidth": 3,
      "semiColons": true,
      "singleQuote": true,
      "lineWidth": 120,
      "include": [
         "cli/",
         "lib/",
         "web/",
         "tests/",
         "scripts/"
      ]
   }
}
